---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import SessionPanel from "../components/SessionPanel.astro";
import SettleBackground from "../components/SettleBackground.astro";
import { sessionHash } from "../lib/session-hash";

// Sort by date, newest first.
const sessions = (await getCollection("session")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = sessions[0]?.data;

// Meta blocks shown in the spine footer, revealed with a scramble effect on load.
const spineMeta = latest
  ? [
      { accent: "green", head: ":", text: `${latest.branch}` },
      {
        accent: "amber",
        head: "@",
        text: sessionHash(latest.branch, latest.commit)
      },
      {
        accent: "violet",
        head: "/",
        text: `rec ${String(latest.record).padStart(2, "0")}`
      }
    ]
  : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title="on_main / 开发者技术沙龙"
      description="on_main 是一个虚拟开发者技术沙龙"
    />
  </head>
  <body class="prototype-label">
    <SettleBackground />
    <main class="label-shell">
      <aside class="spine" aria-label="spine">
        <div class="spine-accent-bar" aria-hidden="true"></div>
        <div class="spine-heading">
          <p class="spine-mobile-eyebrow eyebrow mono">Virtual Developer Meetup</p>
          <div class="spine-title" data-text="on_main">on_main</div>
        </div>
        <div class="spine-top">
          <p class="eyebrow mono">Virtual Developer Meetup</p>
          <span class="spine-registration" aria-hidden="true"></span>
        </div>
        {
          spineMeta.length > 0 && (
            <div class="spine-bottom">
              <p class="spine-foot mono">
                {spineMeta.map((meta) => (
                  <span class="spine-meta-row">
                    <span class="label-tag mono" data-accent={meta.accent}>
                      {meta.head}
                    </span>
                    <span
                      class="label-tag mono scramble"
                      data-accent={meta.accent}
                    >
                      {meta.text}
                    </span>
                  </span>
                ))}
              </p>
            </div>
          )
        }
      </aside>

      <div class="panel-stack">
        {
          sessions.map((s, i) => (
            <SessionPanel id={s.id} session={s.data} isLatest={i === 0} />
          ))
        }
      </div>
    </main>

    <script>
      import "../scripts/home-animations";
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #050a0d;
    --line: rgba(255, 255, 255, 0.08);
    --text: #eef7f1;
    --text-dim: rgba(238, 247, 241, 0.74);
    --text-mute: rgba(238, 247, 241, 0.5);
    --spine-paper: #dce5e2;
    --spine-ink: #121a17;
    --spine-blue: #2848e8;
    --spine-lime: #c8ff42;
    --spine-text: var(--spine-ink);
    --spine-text-dim: rgba(18, 26, 23, 0.62);
    --font-cn:
      "Noto Sans SC Variable", "Noto Sans SC", -apple-system, "PingFang SC",
      "Microsoft YaHei", sans-serif;
    --font-ui:
      "Space Grotesk", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
      sans-serif;
    --font-mono:
      "Space Mono", ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas,
      monospace;
  }

  :global(body.prototype-label) {
    margin: 0;
    color: var(--text);
    background: var(--bg);
    overflow-x: hidden;
    font-family: var(--font-cn);
  }

  :global(body.prototype-label) main {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .label-shell {
    width: 100%;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
  }

  /* === spine ============================================== */
  .spine {
    position: sticky;
    top: 0;
    height: 90vh;
    height: 90svh;
    padding: 30px 24px 22px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--spine-paper);
    background-image:
      linear-gradient(rgba(18, 26, 23, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(18, 26, 23, 0.045) 1px, transparent 1px);
    background-size: 28px 28px;
    color: var(--spine-text);
    box-shadow: inset -1px 0 0 var(--spine-ink);
  }

  .spine-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 1px;
    height: 10px;
    background: var(--spine-blue);
    border-bottom: 2px solid var(--spine-ink);
  }

  .spine-accent-bar::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 28px;
    height: 10px;
    background: var(--spine-lime);
    border-left: 2px solid var(--spine-ink);
  }

  .spine-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--spine-ink);
  }

  .spine-top .eyebrow {
    max-width: 118px;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-wrap: balance;
  }

  .spine-registration {
    position: relative;
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    border: 1px solid var(--spine-ink);
    border-radius: 50%;
  }

  .spine-registration::before,
  .spine-registration::after {
    content: "";
    position: absolute;
    background: var(--spine-blue);
  }

  .spine-registration::before {
    width: 30px;
    height: 1px;
    top: 10px;
    left: -5px;
  }

  .spine-registration::after {
    width: 1px;
    height: 30px;
    top: -5px;
    left: 10px;
  }

  .spine-title {
    position: relative;
    display: block;
    width: fit-content;
    align-self: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-ui);
    font-size: clamp(4.25rem, 10.8vh, 6.75rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.09em;
    color: var(--spine-text);
    margin: auto 0;
    padding: 20px 0;
  }

  .spine-title::before {
    content: attr(data-text);
    position: absolute;
    inset: 20px 0;
    z-index: -1;
    color: var(--spine-blue);
    transform: translate(5px, 4px);
  }

  .spine-mobile-eyebrow {
    display: none;
  }

  .spine-heading {
    display: contents;
  }

  .spine-bottom {
    position: relative;
    padding-top: 13px;
    border-top: 1px solid var(--spine-ink);
  }

  .spine-foot {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    color: var(--spine-text);
  }

  .spine-meta-row {
    display: inline-flex;
    align-items: center;
  }

  /* === panel-stack ======================================== */
  .panel-stack {
    padding: clamp(20px, 3vw, 32px);

    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
    border-top: 1px solid var(--line);
  }

  /* === responsive ========================================= */
  @media (min-width: 1080px) {
    .panel-stack {
      padding-right: 10vw;
    }
    .spine {
      padding-left: 36px;
    }
  }
  @media (max-width: 720px) {
    .label-shell {
      grid-template-columns: 1fr;
    }
    .panel-stack {
      padding-top: 92px;
    }
    .spine {
      position: sticky;
      top: 10px;
      z-index: 10;
      height: 66px;
      width: calc(100% - 20px);
      margin: 10px 10px -68px;
      padding: 0;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      justify-content: space-between;
      gap: 0;
      min-width: 0;
      border: 1px solid var(--spine-ink);
      box-shadow: 4px 4px 0 var(--spine-ink);
      background-size: 20px 20px;
    }
    .spine-accent-bar {
      height: 5px;
      border-bottom-width: 1px;
    }
    .spine-accent-bar::after {
      width: 20px;
      height: 5px;
      border-left-width: 1px;
    }
    .spine-top {
      display: none;
    }
    .spine-title {
      width: fit-content;
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 1.8rem;
      line-height: 1;
      letter-spacing: -0.06em;
      margin: 0;
      padding: 0;
    }
    .spine-title::before {
      inset: 0;
      transform: translate(2px, 2px);
    }
    .spine-bottom {
      display: flex;
      align-items: stretch;
      margin-top: 6px;
      padding: 0;
      border: 0;
    }
    .spine-heading {
      display: block;
      flex: 1;
      align-self: center;
      padding-left: 12px;
    }
    .spine-mobile-eyebrow {
      display: block;
      margin-bottom: 3px;
      font-size: 0.44rem;
      line-height: 1.2;
      letter-spacing: 0.12em;
    }
    .spine-foot {
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: stretch;
      align-items: stretch;
      gap: 0;
      max-width: none;
    }
    .spine-meta-row {
      flex: 1;
      min-height: 0;
      justify-content: flex-end;
      white-space: nowrap;
    }
  }
  @media (max-width: 360px) {
    .spine {
      padding: 0;
    }
    .spine-title {
      font-size: 1.55rem;
    }
    .spine-heading {
      padding-left: 10px;
    }
    .spine-foot {
      max-width: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }

  /* === accent chips (spine) =============================== */
  [data-accent="green"] {
    background: var(--accent-green);
    color: var(--accent-green-fg);
  }
  [data-accent="amber"] {
    background: var(--accent-amber);
    color: var(--accent-amber-fg);
  }
  [data-accent="violet"] {
    background: var(--accent-violet);
    color: var(--accent-violet-fg);
  }
  [data-accent="cyan"] {
    background: var(--accent-cyan);
    color: var(--accent-cyan-fg);
  }
</style>

---
import BarcodeC from "./Barcode.astro";
import type { CollectionEntry } from "astro:content";
import signatureSvg from "../assets/image/signature-svgrepo-com.svg?raw";

type Session = CollectionEntry<"session">["data"];

interface Props {
  id: string;
  session: Session;
  isLatest?: boolean;
}

const { id, session, isLatest = false } = Astro.props;

type RowKey = keyof Pick<Session, "branch" | "hash" | "speaker"> | "record";
type SpecRow = {
  key: RowKey;
  value: string;
  accent: string;
  span: "full" | "cell";
};

const specRows: SpecRow[] = [
  {
    key: "speaker",
    value: session.speaker,
    accent: "cyan",
    span: "full"
  },
  {
    key: "branch",
    value: session.branch,
    accent: "green",
    span: "cell"
  },
  {
    key: "hash",
    value: session.hash,
    accent: "amber",
    span: "cell"
  },
  {
    key: "record",
    value: String(session.record).padStart(2, "0"),
    accent: "violet",
    span: "cell"
  }
];
---

<a class="label-panel" href={`/session/${id}/`}>
  <span class="corner tl" aria-hidden="true"></span>
  <span class="corner tr" aria-hidden="true"></span>
  <span class="corner bl" aria-hidden="true"></span>
  <span class="corner br" aria-hidden="true"></span>

  <div class="lead">
    <h1 class="title">
      {
        isLatest && (
          <span class="title-icon" aria-hidden="true" set:html={signatureSvg} />
        )
      }
      {session.title}
    </h1>
    <p class="summary">{session.summary}</p>
  </div>

  <div class="sheet">
    <div class="spec-grid">
      {
        specRows.map((row) => (
          <article class={row.span === "full" ? "is-full" : undefined}>
            <span class="label-tag mono" data-accent={row.accent}>
              {row.key}
            </span>
            <strong class="mono data">{row.value}</strong>
          </article>
        ))
      }
    </div>
  </div>

  <div class="barcode-strip" aria-hidden="true">
    <BarcodeC
      value={session.bilibili || session.hash}
      height={55}
      color="#0c2e25"
      label={`${session.hash} · ${session.date.toISOString().slice(0, 10)}`}
      vertical
    />
  </div>
</a>

<style>
  /* === label-panel (scoped) =============================== */
  .label-panel {
    position: relative;
    isolation: isolate;
    display: grid;
    color: inherit;
    text-decoration: none;
    /* Lazy-render offscreen cards; browser skips layout/paint until near viewport. */
    content-visibility: auto;
    contain-intrinsic-size: auto 480px;
    padding: clamp(24px, 3vw, 40px);
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: clamp(16px, 3vw, 32px);
    border: 1px solid var(--line);
    /* 半透明底，透出 SlicedWaves 动态背景 */
    background: rgba(5, 10, 13, 0.6);
    transition: box-shadow 0.6s ease;
  }

  .label-panel:hover {
    box-shadow:
      0 0 22px rgba(175, 94, 255, 0.3),
      0 0 14px rgba(0, 215, 255, 0.14);
  }

  /* entrance animation: plays on scroll into view when supported */
  @media (prefers-reduced-motion: no-preference) {
    .label-panel {
      animation: panel-enter 0.7s ease both;
    }
    @supports (animation-timeline: view()) {
      .label-panel {
        animation: panel-enter 0.7s ease both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }

  @keyframes panel-enter {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* corner cut marks (printing trim guides) */
  .corner {
    position: absolute;
    z-index: 1;
    width: 10px;
    height: 10px;
    border: 1px solid var(--text-mute);
    pointer-events: none;
  }
  .corner.tl {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }
  .corner.tr {
    top: -1px;
    right: -1px;
    border-left: none;
    border-bottom: none;
  }
  .corner.bl {
    bottom: -1px;
    left: -1px;
    border-right: none;
    border-top: none;
  }
  .corner.br {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }

  .data {
    font-size: 0.9rem;
  }

  .lead h1 {
    margin: 14px 0 0;
    font-family: var(--font-cn);
    font-weight: 800;
    font-size: clamp(2rem, 5.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    max-width: 16ch;
  }

  /* batch sticker: eyebrow "贴" 在 panel 上沿 */
  .lead > .label-tag {
    position: relative;
    top: -10px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .title {
    position: relative;
    font-family: var(--font-cn);
    font-weight: 800;
    font-size: clamp(2rem, 5.4vw, 3.6rem);
    line-height: 1.05;
    color: var(--text);
  }

  .title-icon {
    position: absolute;
    bottom: -30px;
    left: -18px;
    width: 72px;
    height: 72px;
    z-index: 0;
    color: var(--accent-violet);
  }

  .title-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .title-icon :global(path) {
    stroke: var(--accent-violet);
  }

  .summary {
    max-width: 52ch;
    margin: 18px 0 0;
    font-family: var(--font-cn);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-dim);
  }

  .lead {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sheet {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-content: start;
    height: auto;
  }

  .barcode-strip {
    position: absolute;
    z-index: 0;
    top: clamp(24px, 3vw, 40px);
    right: 0;
    width: clamp(25px, 2.5vw, 35px);
    pointer-events: none;
    overflow: hidden;
  }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .spec-grid article {
    position: relative;
    z-index: 1;
    padding: 12px 9px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.025);
  }

  .spec-grid article.is-full {
    grid-column: 1 / -1;
  }

  .spec-grid article > span {
    display: block;
    margin-bottom: 6px;
  }

  .spec-grid article strong {
    display: block;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    word-break: break-all;
  }

  .caption {
    margin: 0;
    font-family: var(--font-cn);
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  /* === responsive ========================================= */
  @media (max-width: 1079px) {
    .label-panel {
      width: 100%;
      grid-template-columns: 1fr;
      padding: 20px 16px 40px;
    }
  }

  @media (max-width: 640px) {
    .lead h1 {
      font-size: clamp(1.7rem, 9vw, 2.4rem);
    }
  }

  /* === accent chips (spec rows) ============================ */
  [data-accent="green"] {
    background: var(--accent-green);
    color: var(--accent-green-fg);
  }
  [data-accent="cyan"] {
    background: var(--accent-cyan);
    color: var(--accent-cyan-fg);
  }
  [data-accent="amber"] {
    background: var(--accent-amber);
    color: var(--accent-amber-fg);
  }
  [data-accent="violet"] {
    background: var(--accent-violet);
    color: var(--accent-violet-fg);
  }
</style>
